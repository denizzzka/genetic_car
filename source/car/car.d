module car.car;

import dlib.math.vector;
import frame.frame;

/// Полная машина. Хранит уже развёрнутую зеркальным замыканием
/// двустороннюю геометрию вместе с якорями. Позже сюда добавим физику.
class Buggy
{
    /// Полный каркас: узлы (позиции), балки, якоря, соответствие правых/осевых.
    FullFrame full;

    /// Смещение отображения, приводящее каркас к началу координат.
    /// Не меняет геометрию, применяется только при отрисовке.
    vec3 offset;

    this(FullFrame full, vec3 offset = vec3(0.0f))
    {
        this.offset = offset;
        this.full = full;
    }
}
