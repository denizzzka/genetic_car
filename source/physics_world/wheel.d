/**
 * Геометрия колеса каркаса: ось всегда лежит поперёк курса — диск смотрит
 * вперёд, и колесо катится прямо с первого шага, а не скребёт вбок. Шарнир
 * оси и рулевой шарнир живут в бэкенде движка; здесь осталась только
 * геометрия, из которой модель собирает тела.
 *
 * Модуль намеренно лист (не импортирует car.d): ось колеса выводится из
 * одного лишь базиса каркаса, поэтому физика колеса не зависит от сборки
 * заезда.
 */
module physics_world.wheel;

import std.math : PI;

import dlib.math.vector;

/// Радиус колеса по умолчанию, м: значение, которое получает `Anchor`, когда
/// гена `wheelRadius` нет (каркасы, собранные руками). Генетический радиус
/// каждого колеса масштабируется относительно него: внутренний радиус и ширина
/// покрышки растут/сжимаются пропорционально.
enum float defaultWheelRadius = 0.3f;

/// Полуугол поворота рулевой балки, рад (45°).
enum float steerLimitRad = 0.25f * PI;

/// Чувствительность руля: рад угла на рад отклонения от курса.
enum float steerGain = 1.0f;

/// Максимальная коррекция руля за шаг: на ненагруженной балке правка ряда
/// подпитывает своё измерение — без капа балка раскручивается в воронку.
enum float steerErrorCapRad = 0.5f;

/// Ось колеса, удерживающая колесо лицом вперёд: поперёк курса
/// (`cross(up, forward)` — правый луч базиса каркаса), так что плоскость
/// диска совпадает с курсом и колесо катится прямо, как бы ни была
/// направлена балка узла. Знак берётся от стороны колеса (знак проекции
/// `nodePos` на поперечную ось), чтобы
/// обе полосы катились вперёд вместе. `forward`/`up` — ортонормированный
/// базис каркаса; `nodePos` — узел якоря в car-координатах.
vec3 wheelAxle(const vec3 forward, const vec3 up, const vec3 nodePos)
{
    const vec3 across = cross(up, forward);
    return dot(nodePos, across) < 0.0f ? -across : across;
}

/// Своя ступица: колесо и балка делят узел якоря — ось законно проходит через
/// колесо, поэтому контакт с ним провалом не считается.
bool isOwnWheel(size_t wheelNode, size_t beamA, size_t beamB)
{
    return wheelNode == beamA || wheelNode == beamB;
}
